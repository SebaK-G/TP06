@{
    ViewData["Title"] = "Sala 3 - Viaje en el tiempo";
}

<div class="room-page">
    <div class="room-page__content">
        <p class="game-menu__eyebrow">Sala 03 · 5 años tras la derrota</p>
        <h1 class="room-page__title">Viaje en el tiempo</h1>
        <p class="room-page__text">El viaje temporal está desestabilizado. Activá el salto en el momento correcto para llegar a la última batalla.</p>

        <div class="scene-card scene-card--travel">
            <div class="travel-panel">
                <div class="travel-strip" aria-label="Barra de viaje temporal">
                    <div id="travelZone" class="travel-zone" aria-hidden="true"></div>
                    <div id="indicador" class="travel-indicator" aria-hidden="true"></div>
                </div>

                <p id="mensaje" class="travel-message">
                    Ronda 1 de 5. Esperá el momento adecuado...
                </p>

                <div class="game-menu__actions">
                    <button id="botonViaje" class="game-button game-button--primary" type="button" onclick="activarViaje()">
                        Activar viaje <span aria-hidden="true">→</span>
                    </button>
                </div>
            </div>
        </div>

        <form id="formViaje" action="@Url.Action("Sala4", "Juego")" method="post">
        </form>
    </div>
</div>

