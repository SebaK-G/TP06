@{
    ViewData["Title"] = "Victoria";
}
<div class="game-menu">
    <div class="game-menu__content">
        <div class="game-menu__eyebrow">Resultado</div>
        <h1>¡Thanos derrotado!</h1></br>
        <img class="scene-card__image" src="/Imagenes/ThanosDesapareciendo.gif" alt="Thanos derrotado" />
        <p class="game-menu__lead">Has completado todas las salas.</p>
        <div class="game-menu__copy">
            <p>Felicitaciones <strong>@ViewBag.Nombre</strong>, liberaste el poder de las gemas y restauraste el universo.</p>
            <p>Tiempo tardado: <strong>@ViewBag.TiempoPartida segundos</strong>.</p>
        </div>

        <div class="game-menu__actions">
            <a class="game-button game-button--primary" href="/">Volver al inicio</a>
            <a class="game-button game-button--secondary" href="/Juego/Iniciar">Nueva partida</a>
        </div>
    </div>
</div>