@{
    ViewData["Title"] = "Sala 1 - Wakanda";
}

<div class="room-page">
    <div class="room-page__content">
        <p class="game-menu__eyebrow">Sala 01 · Wakanda</p>
        <h1 class="room-page__title">Prepararse para Thanos</h1>
        <p class="room-page__text">Despertás en Wakanda. Hablá con Shuri, Wanda y T'Challa para obtener los números que forman el código.</p>

        <div class="scene-card">
            <img class="scene-card__image" src="/Imagenes/Escena1.png" alt="Escena 1 de Wakanda" />

            <div class="scene-card__actions game-menu__actions">
                <a class="game-button game-button--secondary" href="/Juego/MensajesSala1?personaje=TChalla">T'Challa</a>
                <a class="game-button game-button--secondary" href="/Juego/MensajesSala1?personaje=Shuri">Shuri</a>
                <a class="game-button game-button--secondary" href="/Juego/MensajesSala1?personaje=Wanda">Wanda</a>
            </div>

            @if (ViewBag.Personaje == "Shuri"){
                <div>
                    <h2>Shuri</h2>
                    <p>Vision debe ser protegido a toda costa. La respuesta se encuentra donde nadie mira.</p>
                </div>
            }
            @if (ViewBag.Personaje == "Wanda"){
                <div>
                    <h2>Wanda</h2>
                    <p>Thanos buscará llegar hasta Vision. No dejes que atraviese el campo de batalla.</p>
                </div>
            }
            @if (ViewBag.Personaje == "TChalla"){
                <div>
                    <h2>Black Panther</h2>
                    <p>El camino correcto comienza siguiendo las señales.</p>
                </div>
            }
        </div>

        <form class="game-form room-form" method="post" action="/Juego/ResponderSala1">
            <label for="respuesta">Código de 4 números</label>
            <input id="respuesta" name="respuesta" type="text" maxlength="4" inputmode="numeric" required />
            <button class="game-button game-button--primary" type="submit">Enviar <span aria-hidden="true">→</span></button>
        </form>

        @if (ViewBag.Error != null)
        {
            <p class="game-form__error">@ViewBag.Error</p>
        }
    </div>
</div>

