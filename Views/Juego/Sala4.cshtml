@{
    ViewData["Title"] = "Sala 4 - Recuperar las gemas";
}

<h2>Recuperar las Gemas</h2>
<p>Colocá las 6 gemas en el orden correcto (separadas por comas):</p>

<form method="post" action="/Juego/SubmitSala">
    <input type="hidden" name="salaId" value="4" />
    <div class="mb-3">
        <input class="form-control" name="respuesta" placeholder="Tiempo,Espacio,Realidad,Poder,Mente,Alma" />
    </div>
    <button class="btn btn-success">Colocar gemas</button>
    <a class="btn btn-link" href="#" onclick="fetch('/Home/Hint?salaId=4').then(r=>r.text()).then(t=>{document.getElementById('hint').innerHTML=t})">Pista</a>
    <div id="hint" class="mt-3"></div>
</form>

@if(TempData["Error"] != null){<div class="text-danger">@TempData["Error"]</div>}