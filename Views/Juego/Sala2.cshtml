@{
    ViewData["Title"] = "Sala 2 - El Laberinto de Wakanda";
}

<div class="room-page">
    <div class="room-page__content">
        <p class="game-menu__eyebrow">Sala 02 · Wakanda</p>
        <h1 class="room-page__title">Escapar del Laberinto</h1>
        <p class="room-page__text">Shuri necesita tu ayuda. Escapá del laberinto de Wakanda usando W, A, S, D. Encuentra la salida verde.</p>



        <div class="scene-card">
            <div class="maze-container">
                <canvas id="mazeCanvas" width="600" height="600" class="maze-canvas"></canvas>
                <div id="mazeStatus" class="maze-status" style="display: none;">
                    <p class="maze-mensaje">¡Escapaste del laberinto! 🎉</p>
                </div>
            </div>

            <p id="mazeMessage" class="maze-message" style="display: none;">
                ¡Escapaste del laberinto!
            </p>

            <div class="game-menu__actions">
                <p class="maze-controls__text">Usa <strong>W, A, S, D</strong> para moverte</p>
            </div>

            <form id="laberintoForm" method="post" action="/Juego/CompletarSala2" style="display: none;">
                <button type="submit"></button>
            </form>
        </div>
    </div>
</div>

<style>
    .maze-container {
        position: relative;
        display: flex;
        justify-content: center;
        margin: 1.5rem auto;
        max-width: 650px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        padding: 1rem;
        border-radius: 8px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .maze-canvas {
        display: block;
        border: 2px solid #00d4ff;
        border-radius: 4px;
        background: #0f1419;
        cursor: none;
        max-width: 100%;
        height: auto;
    }

    .maze-status {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 212, 255, 0.95);
        padding: 2rem 3rem;
        border-radius: 8px;
        text-align: center;
        z-index: 10;
        box-shadow: 0 8px 32px rgba(0, 212, 255, 0.4);
    }

    .maze-status__text {
        margin: 0;
        font-size: 1.8rem;
        font-weight: bold;
        color: #0f1419;
    }

    .maze-controls__text {
        margin: 0.5rem 0 0 0;
        font-size: 0.95rem;
        color: #a0a0a0;
        text-align: center;
    }
</style>